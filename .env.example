# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/shipex_db

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=3600

# Server Configuration
PORT=5000
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=info
# Options: error, warn, info, debug, verbose
LOG_RESPONSE_DATA=false
# Set to true to log response data (useful for debugging, but verbose)

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:5000

# API Configuration
API_URL=http://localhost:5000

# Storage Configuration
STORAGE_DRIVER=local
# For S3/Cloud Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name

# Email Configuration (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Stripe Configuration (Billing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:3000

# Google Maps API (for address validation)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Sentry Configuration (Error Tracking - Phase 15)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Data Encryption (Phase 14)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-encoded-encryption-key-here

